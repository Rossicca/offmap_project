# 复制本文件为 server/.env 并填写（.env 已被 gitignore，不会提交）

# 方舟 (Ark) — https://console.volcengine.com/ark → API Key 管理
ARK_API_KEY=在此填写你的方舟API Key
# 模型需先在方舟控制台「开通管理」开通；新开通模型通常有约 50 万 token 免费额度
ARK_VISION_MODEL=doubao-1-5-vision-pro-32k-250115

# 语音技术 — 控制台开通「大模型流式语音识别 2.0」后，
# 在「应用管理」创建应用获得 APP ID 与 Access Token；资源 ID 见「资源包管理」
SPEECH_APP_ID=在此填写语音应用APP ID
SPEECH_ACCESS_TOKEN=在此填写语音应用Access Token
SPEECH_RESOURCE_ID=volc.seedasr.sauc.duration
